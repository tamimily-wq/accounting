rules_version = '2';

// كيفية التفعيل:
// 1. افتح Firebase Console -> مشروعك (my-accounting-1cad7)
// 2. من القائمة الجانبية: Firestore Database -> تبويب Rules
// 3. احذف كل المحتوى الحالي، والصق هذا الملف كامل مكانه
// 4. اضغط Publish
//
// شرط مسبق لازم تسويه قبل النشر، وإلا التطبيق ما راح يقدر يقرأ/يكتب أبداً:
// من القائمة الجانبية: Authentication -> Sign-in method -> فعّل مزوّد
// "Anonymous" (مجهول الهوية). بدون هذه الخطوة، لا يوجد request.auth أصلاً
// وهذه القواعد سترفض كل الطلبات.

service cloud.firestore {
  match /databases/{database}/documents {

    // المستند الوحيد اللي يستخدمه التطبيق فعلياً: accounting/main
    // مسموح بالقراءة/الكتابة فقط لمن سجّل دخول (ولو مجهول الهوية) — يمنع
    // أي قراءة/كتابة مباشرة غير مصادَق عليها من خارج التطبيق (سكربتات،
    // فحص تلقائي، متصفح REST API مباشر بدون تشغيل الصفحة).
    match /accounting/main {
      allow read, write: if request.auth != null;
    }

    // أي مسار آخر غير هذا محظور تماماً افتراضياً (دفاع إضافي احترازي حتى لو
    // أُضيفت مجموعة بيانات جديدة لاحقاً بالخطأ بدون تحديث هذه القواعد).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
